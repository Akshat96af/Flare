{
  "name": "flare-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A voice and keyboard command center for Windows 11",
  "author": "Akshat96af",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "package": "npm run build && electron-builder --win nsis zip",
    "package:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "exif-reader": "^2.0.3",
    "fast-xml-parser": "^5.0.0",
    "koffi": "^2.15.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "mathjs": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "dev.flare.desktop",
    "productName": "Flare",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/koffi/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Flare-${version}-${arch}.${ext}"
  }
}
